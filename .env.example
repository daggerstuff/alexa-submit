LOG_LEVEL=INFO
MCP_ENDPOINT=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
# If set, the /mcp endpoint requires `Authorization: Bearer <key>` or `X-API-Key: <key>`.
MCP_API_KEY=
# Per-client request limit over the window; 0 disables rate limiting.
MCP_RATE_LIMIT_REQUESTS=0
MCP_RATE_LIMIT_WINDOW_SECONDS=60
# Only trust X-Forwarded-For for rate limiting when behind a trusted proxy
# (e.g. App Runner). Leave unset when clients connect directly.
MCP_TRUST_PROXY=
# Idle session expiry (seconds; 0 disables) and max concurrent in-memory sessions.
SESSION_TTL_SECONDS=1800
SESSION_MAX_SESSIONS=1000
# Optional SQLite session store; unset disables persistence (in-memory only).
SESSION_DB_PATH=
# When true, register list_sessions/delete_session MCP tools (off by default:
# they reveal session IDs to any API-key holder).
MCP_EXPOSE_SESSION_TOOLS=
# When true, register the get_learner_progress MCP tool (off by default:
# learner identifiers may be personal data).
MCP_EXPOSE_LEARNER_TOOLS=
# When true, register the list_cohort_progress MCP tool (off by default:
# it reveals every learner identifier and aggregate progress).
MCP_EXPOSE_COHORT_TOOLS=
# Optional LLM patient persona.
#   mock    → deterministic scripted persona (default, no keys needed)
#   bedrock → Amazon Bedrock Converse API; requires BEDROCK_MODEL_ID and AWS
#             credentials (env/instance role).
INFERENCE_PROVIDER=mock
# Bedrock provider (used when INFERENCE_PROVIDER=bedrock). Use a Bedrock model
# or inference-profile ID — verify with `aws bedrock list-foundation-models`.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
