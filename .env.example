APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# If set, /alexa, /mcp/simulate, and session deletion require X-API-Key.
DEV_API_KEY=
MCP_ENDPOINT=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
ALEXA_SKILL_ID=replace-with-alexa-skill-id
ALEXA_CLIENT_ID=replace-with-developer-client-id
ALEXA_CLIENT_SECRET=replace-with-developer-client-secret
INFERENCE_PROVIDER=mock
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=gpt-4o-mini
INFERENCE_TIMEOUT=15
